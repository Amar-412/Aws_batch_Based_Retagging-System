# ---------------------------------------------------------------------------
# S3 Batch Retagging & Policy Management System - Backend Environment Example
# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file. NEVER hardcode credentials in source code.
# ---------------------------------------------------------------------------

# Server
PORT=5000

# AWS core configuration
AWS_REGION=your-region
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key

# S3
S3_BUCKET=your-bucket
MANIFEST_PREFIX=manifests/
REPORT_PREFIX=reports/

# S3 Batch Operations IAM role (used by S3 to perform the retagging job)
BATCH_OPERATIONS_ROLE_ARN=your-role-arn

# DynamoDB (application-level job metadata)
DYNAMODB_TABLE=RetaggingJobs

# CSV upload limits
MAX_UPLOAD_SIZE_MB=5
# Application safety cap for a single CSV. S3 Batch Operations can scale beyond this later.
MAX_CSV_OBJECTS=10000

# CORS: comma-separated list of allowed frontend origins (optional)
# Defaults to allowing all origins in development if left unset.
CORS_ORIGIN=http://localhost:5173
